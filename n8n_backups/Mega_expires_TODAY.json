      "parameters": {
        "jsCode": "const now = new Date();\nconst caracasOffset = -4 * 60;\nconst localNow = new Date(now.getTime() + (now.getTimezoneOffset() + caracasOffset) * 60000);\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst todayStr = `${localNow.getFullYear()}-${pad(localNow.getMonth() + 1)}-${pad(localNow.getDate())}`;\n\nconst getField = (obj, regex) => {\n  if (!obj) return '';\n  for (const k of Object.keys(obj)) {\n    if (regex.test(k)) {\n      const v = obj[k];\n      if (v !== undefined && v !== null) return v;\n    }\n  }\n  return '';\n};\n\nconst getAmount = (obj) => {\n  if (!obj) return 0;\n  for (const k of Object.keys(obj)) {\n    if (/monto|amount/i.test(k)) {\n      const v = obj[k];\n      if (v !== undefined && v !== null && v !== '') {\n        const n = parseFloat(String(v).replace(/[^0-9.]/g, ''));\n        if (!isNaN(n) && n > 0) return n;\n      }\n    }\n  }\n  return 0;\n};\n\nconst normalizeDate = (val) => {\n  if (!val) return '';\n  const raw = String(val).trim().split(' ')[0].split('T')[0];\n  const p = raw.split(/[\\/\\-]/);\n  if (p.length === 3) {\n    return p[0].length === 4\n      ? `${p[0]}-${pad(p[1])}-${pad(p[2])}`\n      : `${p[2].length === 2 ? '20' + p[2] : p[2]}-${pad(p[1])}-${pad(p[0])}`;\n  }\n  return raw;\n};\n\nconst results = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i].json;\n  const rawVence = getField(row, /^vence/i);\n  const venceIso = normalizeDate(rawVence);\n  const play = String(getField(row, /^play/i)).trim();\n  const email = String(getField(row, /^email/i)).trim();\n  const usuario = String(getField(row, /^usuario/i)).trim();\n  const nombre = String(getField(row, /^nombre/i) || 'Customer').trim();\n  const pagaPor = String(getField(row, /^paga/i)).trim().toLowerCase();\n  const telefono = String(getField(row, /^tel|phone/i)).replace(/\\D/g, '');\n  const numAmount = getAmount(row) || 20;\n  const cleanAmount = numAmount.toFixed(2);\n  const cryptoNum = Number((numAmount * 0.8).toFixed(2));\n  const cryptoAmount = cryptoNum.toFixed(2);\n\n  if (venceIso === todayStr && play !== 'SENT' && usuario !== '') {\n    results.push({\n      json: {\n        ...row,\n        row_number: i + 2,\n        Nombre: nombre,\n        Email: email,\n        Usuario: usuario,\n        Telefono: telefono,\n        Vence: venceIso,\n        Ultimo_Monto: cleanAmount,\n        Crypto_Monto: cryptoAmount,\n        crypto_num: cryptoNum,\n        is_zelle: (pagaPor === 'zelle'),\n        checkout_url: 'http://totaltvusa.com/',\n        category: 'vence_hoy'\n      }\n    });\n  } else if (venceIso < todayStr && play !== '' && usuario !== '') {\n    results.push({\n      json: {\n        ...row,\n        row_number: i + 2,\n        Usuario: usuario,\n        Vence: venceIso,\n        category: 'limpiar_pasados'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
