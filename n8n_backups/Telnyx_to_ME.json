        "messageText": "={{ \n  (() => {\n    const payload = $json.body?.data?.payload || {};\n    const direction = payload.direction; // \"outbound\" o \"inbound\"\n    const isOutbound = direction === 'outbound';\n    \n    let text = \"\";\n    \n    if (isOutbound) {\n      // 1. EXTRAER ESTADO DE SALIDA\n      const toData = payload.to?.[0] || {};\n      const status = toData.status || \"unknown\"; // \"delivery_failed\", \"delivered\", \"queued\", etc.\n      let statusEmoji = \"⏳\";\n      if (status === \"delivered\") statusEmoji = \"✅\";\n      if (status === \"delivery_failed\") statusEmoji = \"❌\";\n      \n      text += `📤 *SMS Saliente (Reporte)*\\n`;\n      text += `📱 *Para:* ${toData.phone_number || 'N/A'}\\n`;\n      text += `📥 *Desde:* ${payload.from?.phone_number || 'N/A'}\\n`;\n      text += `${statusEmoji} *Estado:* ${status.toUpperCase()}\\n`;\n      \n      // Si hay errores, los detalla\n      if (payload.errors && payload.errors.length > 0) {\n        text += `⚠️ *Error:* ${payload.errors[0].title} (Código: ${payload.errors[0].code})\\n`;\n        text += `🔍 *Detalle:* ${payload.errors[0].detail}\\n`;\n      }\n    } else {\n      // 2. DETECTAR SMS ENTRANTE (INBOUND)\n      text += `📩 *SMS Recibido (Entrante)*\\n`;\n      text += `📱 *De:* ${payload.from?.phone_number || 'N/A'}\\n`;\n      text += `📥 *Recibido en:* ${payload.to?.[0]?.phone_number || 'N/A'}\\n`;\n    }\n    \n    // Agregar el contenido del mensaje al final\n    text += `💬 *Mensaje:* ${payload.text || ''}`;\n    \n    return text;\n  })()\n}}",
        "options_message": {}
      },
