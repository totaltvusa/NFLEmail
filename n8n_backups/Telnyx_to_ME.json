        "text": "={{ \n  (() => {\n    const payload = $json.body.data.payload;\n    const direction = payload.direction; // \"outbound\" o \"inbound\"\n    const isOutbound = direction === 'outbound';\n    \n    let text = \"\";\n    \n    if (isOutbound) {\n      // 1. EXTRAER ESTADO DE SALIDA\n      const status = payload.to[0].status; // \"delivery_failed\", \"delivered\", \"queued\", etc.\n      let statusEmoji = \"⏳\";\n      if (status === \"delivered\") statusEmoji = \"✅\";\n      if (status === \"delivery_failed\") statusEmoji = \"❌\";\n      \n      text += `📤 <b>SMS Saliente (Reporte)</b>\\n`;\n      text += `📱 <b>Para:</b> ${payload.to[0].phone_number}\\n`;\n      text += `📥 <b>Desde:</b> ${payload.from.phone_number}\\n`;\n      text += `${statusEmoji} <b>Estado:</b> ${status.toUpperCase()}\\n`;\n      \n      // Si hay errores, los detalla\n      if (payload.errors && payload.errors.length > 0) {\n        text += `⚠️ <b>Error:</b> ${payload.errors[0].title} (Código: ${payload.errors[0].code})\\n`;\n        text += `🔍 <b>Detalle:</b> ${payload.errors[0].detail}\\n`;\n      }\n    } else {\n      // 2. DETECTAR SMS ENTRANTE (INBOUND)\n      text += `📩 <b>SMS Recibido (Entrante)</b>\\n`;\n      text += `📱 <b>De:</b> ${payload.from.phone_number}\\n`;\n      text += `📥 <b>Recibido en:</b> ${payload.to[0].phone_number}\\n`;\n    }\n    \n    // Agregar el contenido del mensaje al final\n    text += `💬 <b>Mensaje:</b> ${payload.text}`;\n    \n    return text;\n  })()\n}}",
